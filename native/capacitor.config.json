{
  "appId": "com.errerlabs.vegnourish",
  "appName": "Veg-Nourish",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f1f5f3",
    "limitsNavigationsToAppBoundDomains": true,
    "scheme": "Veg-Nourish",
    "preferredContentMode": "mobile"
  },
  "server": {
    "iosScheme": "app"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#1f6f4a",
      "sound": "default"
    }
  }
}
