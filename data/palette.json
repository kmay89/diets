  "render": {
    "note": "How much color a card is allowed. Kept low on purpose: the tint is a wash behind the art and a hairline at the edge, never behind body text, so contrast is decided by the theme and not by whatever is in the pot.",
    "light": {
      "wash": 14,
      "washFar": 8,
      "edge": 34,
      "chipEdge": 40
    },
    "dark": {
      "wash": 20,
      "washFar": 12,
      "edge": 32,
      "chipEdge": 38
    },
    "angles": [
      135,
      160,
      115,
      145,
      170,
      125
    ],
    "maxSat": 66,
    "minSat": 18,
    "vividBonus": 1.35,
    "vividFrom": 40,
    "vividNote": "A pot is described by its most vivid thing — people say 'the red one', not 'the beige one with red in it'. So a saturated group gets a thumb on the scale against a pale one, which is both how a cook would name the dish and what makes a grid of cards easiest to scan."
  },
  "textures": {
    "note": "A pattern per way of cooking, so two dishes the same color still read differently. Derived from what the recipe actually does — the crosshatch is a grill mark, the stipple is browning, the ripple is a pot at a simmer — rather than assigned for variety's sake. All of them are CSS gradients: no images, no requests, nothing for the content policy to argue with.",
    "order": [
      "grill",
      "fresh",
      "ripple",
      "grain",
      "steam",
      "stipple"
    ],
    "rules": [
      {
        "id": "grill",
        "name": "Crosshatch",
        "means": "Live fire, and the marks it leaves.",
        "tags": [
          "grill",
          "cookout"
        ],
        "words": [
          "grill",
          "grate over the coals",
          "char"
        ]
      },
      {
        "id": "fresh",
        "name": "Scatter",
        "means": "Nothing cooked. Assembled, dressed and eaten.",
        "tags": [
          "no-cook",
          "salad",
          "slaw",
          "smoothie",
          "dip",
          "raw"
        ],
        "words": [
          "toss together",
          "no cooking"
        ]
      },
      {
        "id": "ripple",
        "name": "Ripple",
        "means": "A pot with liquid in it, left alone.",
        "tags": [
          "soup",
          "stew",
          "one-pot",
          "slow-cooker",
          "braise"
        ],
        "words": [
          "simmer",
          "braise",
          "stir in the broth",
          "cover and cook"
        ]
      },
      {
        "id": "grain",
        "name": "Grain",
        "means": "Flour, dough and the oven — anything built rather than cooked.",
        "tags": [
          "pasta",
          "noodles",
          "baking",
          "dessert",
          "bread"
        ],
        "words": [
          "knead",
          "fold the dry",
          "batter",
          "dough"
        ]
      },
      {
        "id": "steam",
        "name": "Steam",
        "means": "Vapor and gentle heat.",
        "tags": [
          "steamed"
        ],
        "words": [
          "steam",
          "steamer",
          "poach"
        ]
      },
      {
        "id": "stipple",
        "name": "Stipple",
        "means": "Dry heat and browning — a sheet pan, a hot skillet, an air fryer.",
        "tags": [
          "sheet-pan",
          "roast",
          "baked",
          "air-fryer",
          "skillet"
        ],
        "words": [
          "roast",
          "sear",
          "until golden",
          "sheet pan",
          "air fryer"
        ]
      }
    ],
    "fallback": "stipple",
    "orderNote": "Checked in this order, so the specific wins over the general: a soup that happens to say 'roast the peppers first' is still a soup. Stipple comes last because browning is what most cooking is, which makes it the honest catch-all rather than the interesting answer."
  },
  "overrideNote": "A recipe may set a \"color\" field naming one of these groups, and it wins over the arithmetic. Reserved for dishes whose identity the ingredient list genuinely cannot see — a white chili, a green curry that is mostly coconut milk by weight. It is not a way to make a card prettier: a smoothie with a cup and a half of frozen berries in it is purple, whatever it is called."
}
